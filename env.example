# Orvia 后端环境变量模板
#
# 用法：cp .env.example .env，然后按注释填写。
# 真实凭证只放 .env（已被 .gitignore 忽略），不要写进本文件或提交到 Git。
# 完整说明见 docs/ENVIRONMENT.md。

# ---------- 运行环境 ----------

# 运行环境标识。development / production
NODE_ENV=development

# API 监听地址。对外提供服务时可设为 0.0.0.0
HOST=127.0.0.1

# API 监听端口
PORT=4100

# ---------- 数据库与缓存 ----------

# MySQL 连接串（必需）。密码含 @ # ? & 等字符时必须 URL 编码。
DATABASE_URL=mysql://用户名:密码@127.0.0.1:3306/orvia?charset=utf8mb4&multipleStatements=true&timezone=%2B08%3A00

# Redis 连接串（必需）。有密码时写成 redis://:密码@127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379

# ---------- Pi Runtime ----------

# Pi CLI 命令或完整路径。启动 API 时会校验，执行 Session / 面板对话时实际调用。
PI_COMMAND=pi

# 模型厂商凭证（可选）。Orvia 不传 --provider / --model，
# 通常用 Pi 本机已保存的默认模型配置；此处仅在启动 API 的进程里没有 Pi 登录态时兜底。
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---------- 控制台与鉴权 ----------

# CORS 与 SSE 来源，必须和浏览器打开控制台的地址一致
WEB_ORIGIN=http://localhost:3000

# Bearer 令牌。NODE_ENV=production 时缺失会拒绝启动。
# 生产环境务必设置为随机长字符串。
# ORVIA_API_TOKEN=

# 启动时创建的本机管理员（可选）。仅本机引导用，不要用于生产。
ORVIA_BOOTSTRAP_EMAIL=admin@local.orvia
ORVIA_BOOTSTRAP_PASSWORD=orvia-local

# ---------- 测试 ----------

# 配置后 pnpm test 会执行 HTTP Golden Path 集成测试。
# 请使用专用空库，不要指向生产数据。
# ORVIA_INTEGRATION_DATABASE_URL=
